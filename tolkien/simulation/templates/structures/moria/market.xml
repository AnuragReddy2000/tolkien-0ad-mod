<?xml version="1.0" encoding="utf-8"?>
<Entity parent="template_structure_economic_market">
  <!-- Stone-built structures (docs/factions/moria.md): half the Wood cost
       becomes Stone, combined resource cost unchanged (300 -> 150 + 150). -->
  <Cost>
    <BuildTime>150</BuildTime>
    <Resources>
      <food>0</food>
      <wood>150</wood>
      <stone>150</stone>
      <metal>0</metal>
    </Resources>
  </Cost>
  <Identity>
    <Civ>moria</Civ>
    <SpecificName>Hall of Exchange</SpecificName>
  </Identity>
  <!-- Explicit list: vanilla market techs plus the two Dwarven food
       techs (trade-for-food replaces the removed farm upgrades). -->
  <Researcher>
    <Technologies datatype="tokens">
      trader_health
      trade_gain_01
      trade_gain_02
      trade_commercial_treaty
      unlock_shared_los
      unlock_shared_dropsites
      moria_pacts_with_dale
      moria_deep_larders
    </Technologies>
  </Researcher>
  <Trainer>
    <Entities datatype="tokens">
      units/{civ}/support_trader
    </Entities>
  </Trainer>
  <VisualActor>
    <Actor>structures/carthaginians/market.xml</Actor>
  </VisualActor>
</Entity>
