<?xml version="1.0" encoding="utf-8"?>
<!-- The Dark Lord himself: Sketchfab Sauron by rokaarh (CC BY 4.0),
     decimated, baked to one 512px skin, rigged to stock Biped.
     Mesh: skeletal/tolkien/sauron.dae (~5.2 game units tall).
     Anims: custom menacing idle + retargeted walk/run/melee/capture
     (biped/sauron_*.dae); death/promotion stock. Mace merged into the mesh. -->
<actor version="1">
  <castshadow/>
  <group>
    <variant frequency="1" name="Base">
      <mesh>skeletal/tolkien/sauron.dae</mesh>
      <textures>
        <texture file="skeletal/tolkien/sauron_body.png" name="baseTex"/>
        <texture file="default_norm.png" name="normTex"/>
        <texture file="null_black.dds" name="specTex"/>
      </textures>
    </variant>
  </group>
  <group>
    <variant file="biped/sauron_relax.xml"/>
    <variant file="biped/sauron_capture.xml"/>
    <variant file="biped/attack_slaughter.xml"/>
    <variant file="biped/death_infantry.xml"/>
  </group>
  <group>
    <variant>
      <textures>
        <texture file="default_norm.png" name="normTex"/>
        <texture file="null_black.dds" name="specTex"/>
      </textures>
    </variant>
  </group>
  <material>player_trans_norm_spec.xml</material>
</actor>
