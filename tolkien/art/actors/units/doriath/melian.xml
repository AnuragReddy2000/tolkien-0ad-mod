<?xml version="1.0" encoding="utf-8"?>
<!-- Melian, Queen of Doriath: Boudicca's dress/head/cape with a healer's
     staff, animated as a female healer (Heal/Idle/Walk from
     biped/base_healer_female.xml, after the German seeress pattern).
     Pure healer + Girdle aura; no attack, no melee anims. -->
<actor version="1">
  <castshadow/>
  <group>
    <variant file="biped/base_healer_female.xml">
      <mesh>skeletal/new/f_armor_dress.dae</mesh>
      <props>
        <prop actor="props/units/heads/new/head_celt_boudicca.xml" attachpoint="head"/>
        <prop actor="props/units/staff.xml" attachpoint="weapon_R"/>
        <prop actor="props/units/capes/cape_long_gaul.xml" attachpoint="root"/>
      </props>
      <textures>
        <texture file="skeletal/brit/dress_female_boudicca_02.png" name="baseTex"/>
        <texture file="default_norm.png" name="normTex"/>
        <texture file="null_black.dds" name="specTex"/>
      </textures>
    </variant>
  </group>
  <group>
    <variant name="Idle" frequency="1"/>
    <variant file="biped/gather_praise.xml"/>
    <variant file="biped/death_cape_gaul.xml"/>
  </group>
  <material>player_trans_norm_spec.xml</material>
</actor>
